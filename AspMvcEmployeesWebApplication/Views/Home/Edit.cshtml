@using AspMvcEmployeesWebApplication.Models;
@model Employee

<h2>Edit Employee</h2>
<form asp-action="edit" asp-controller="home" method="post" asp-route-id="@Model.Id">
    <div>
        <label asp-for="Name">Name</label>
        <input asp-for="Name" />
    </div>
    <div>
        <label asp-for="Age">Age</label>
        <input asp-for="Age" />
    </div>
    <div>
        <input type="submit" value="Save" />
    </div>
</form>