@using AspMvcEmployeesWebApplication.Models
@model IEnumerable<Employee>

@{
    ViewData["Title"] = "Employees List";
}

<h2>@ViewData["Title"]</h2>
<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSort"]">
                    Name
                </a>
            </th>
            <th>
               <a asp-action="Index" asp-route-sortOrder="@ViewData["AgeSort"]">
                   Age
                </a>
            </th>
            <th>
               <a asp-action="Index" asp-route-sortOrder="@ViewData["CompanySort"]">
                    Company
               </a>
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach(var e in Model)
        {
            <tr>
                <td>@e.Name</td>
                <td>@e.Age</td>
                <td>@e.Company.Title</td>
            </tr>
        }
    </tbody>
</table>
